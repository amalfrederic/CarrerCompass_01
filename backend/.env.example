# =================================================================
# CareerCompass Backend Environment Configuration Example
# Copy to .env and configure appropriately for local or AWS deployment
# =================================================================

# --- Application & Logging ---
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000

# --- Database (PostgreSQL / Amazon RDS) ---
# Format: postgresql://username:password@rds-endpoint:5432/database_name
DATABASE_URL=postgresql://postgres:password@localhost:5432/resume_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
REQUIRE_DB=true

# --- Authentication & Security ---
SECRET_KEY=careercompass_jwt_secret_change_to_a_secure_random_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS Allowed Origins ---
# Comma-separated list of allowed origins (e.g. local Vite dev server and CloudFront domain)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- LLM Provider Selection ---
# Options: "groq" (default) or "bedrock" (AWS Bedrock)
LLM_PROVIDER=groq

# --- Groq Provider Configuration (Active by default) ---
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- Amazon Bedrock Provider Configuration (Optional AWS Native) ---
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
# Note: In AWS ECS Fargate, AWS credentials are automatically provided by the IAM Task Role.
# In local development with Bedrock, configure AWS_ACCESS_KEY_ID & AWS_SECRET_ACCESS_KEY or ~/.aws/credentials.
